# microservice specific routes

PUT          /user-answers                                  uk.gov.hmrc.vapingduty.controllers.UserAnswersController.set()
GET          /user-answers/:vpdId/:periodKey                uk.gov.hmrc.vapingduty.controllers.UserAnswersController.getUserAnswers(vpdId: VpdId, periodKey: PeriodKey)
DELETE       /user-answers/clear/:vpdId/:periodKey          uk.gov.hmrc.vapingduty.controllers.UserAnswersController.clear(vpdId: VpdId, periodKey: PeriodKey)
POST         /user-answers/keep-alive/:vpdId/:periodKey     uk.gov.hmrc.vapingduty.controllers.UserAnswersController.keepAlive(vpdId: VpdId, periodKey: PeriodKey)

GET          /obligations/:vpdId                            uk.gov.hmrc.vapingduty.controllers.ObligationsController.get(vpdId: VpdId)

POST         /vpd-return/:vpdId/:periodKey                  uk.gov.hmrc.vapingduty.controllers.ReturnsController.submitReturn(vpdId: VpdId, periodKey: PeriodKey)
GET          /vpd-return/:periodKey/:vpdId                  uk.gov.hmrc.vapingduty.controllers.ReturnsController.getReturn(periodKey: PeriodKey, vpdId: VpdId)
